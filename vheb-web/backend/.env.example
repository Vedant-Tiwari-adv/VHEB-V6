# Copy this file to .env for local development.
# On Render (or any host) set these as real environment variables instead --
# never commit a filled-in .env file.

# --- Auth ---------------------------------------------------------
# Any long random string. The frontend will ask you to paste this once
# and stores it in the browser for future visits.
ADMIN_TOKEN=change-me-to-something-long-and-random

# --- Google Sheets / Drive (README step 2-3) -----------------------
# Paste the ENTIRE service-account JSON key as one line here.
GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", "...": "..."}
# The long ID from your Google Sheet's URL:
# https://docs.google.com/spreadsheets/d/THIS_PART/edit
SPREADSHEET_ID=
# Only needed if you use the meter-photo feature (README step 3c):
DRIVE_PHOTOS_FOLDER_ID=

# --- WhatsApp Cloud API (README step 4) -----------------------------
# Every bill message is sent to YOUR OWN number below -- you check each
# one, then forward it to the tenant yourself. Set this to your number
# in international format (no +, no spaces).
ADMIN_WHATSAPP_NUMBER=919373834997
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=monthly_bill
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_API_VERSION=v21.0

# --- Building defaults ----------------------------------------------
DEFAULT_MARGIN_PCT=7
BUILDING_NAME=Your Building Name
CURRENCY_SYMBOL=Rs
TIMEZONE=Asia/Kolkata

# --- Only needed if the frontend is hosted separately from the API ---
EXTRA_CORS_ORIGINS=
